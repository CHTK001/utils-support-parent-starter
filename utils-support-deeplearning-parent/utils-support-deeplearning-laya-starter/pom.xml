<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>utils-support-deeplearning-parent</artifactId>
        <version>4.0.0.42</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>utils-support-deeplearning-laya-starter</artifactId>
    <name>Utils Support Deep Learning Laya Starter</name>
    <description>Laya 本地概率决策推理集成：基于 laya-java 的 NOUL / CHOICE / SCORE 类型化决策（SPI provider="laya"）</description>
    <properties>
        <laya-java.version>0.1.0</laya-java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
        </dependency>
        <!-- laya-java：本地 Laya 决策推理（ONNX Runtime + DJL tokenizers + Jackson）。
             其传递的 onnxruntime 1.24.2 与本仓 onnx-starter 的 1.30.0 共存会炸原生库，
             此处排除后由本模块显式声明 1.30.0；tokenizers / jackson-databind
             与本仓 BOM 版本一致，直接沿用传递版本。 -->
        <dependency>
            <groupId>io.github.pig-mesh.ai</groupId>
            <artifactId>laya-java</artifactId>
            <version>${laya-java.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>com.microsoft.onnxruntime</groupId>
                    <artifactId>onnxruntime</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <version>1.30.0</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.13.0-M3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
