<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>utils-support-deeplearning-parent</artifactId>
        <version>4.0.0.51</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
<artifactId>utils-support-deeplearning-onnx-starter</artifactId>
  <name>Utils Support Deep Learning ONNX Starter</name>
  <description>ONNX 推理引擎模块：YOLO 检测、图像分类等模型推理</description>
  <properties>
    <!--
      父 pom 的 dev profile 默认 skipTests=true，会让本模块的验收测试被静默跳过
      （BUILD SUCCESS 但 0 用例）。本模块含 LAC 等需要真实推理的验收用例，
      必须默认执行，否则等于没验收；与 utils-support-ast-starter /
      utils-support-deeplearning-agentscope-starter 保持同一约定。
    -->
    <skipTests>false</skipTests>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <fork>false</fork>
          <testExcludes>
            <testExclude>**/VitH14OnnxTranslatorTest.java</testExclude>
            <testExclude>**/AudioFullTest.java</testExclude>
            <testExclude>**/AudioRecognitionExample.java</testExclude>
            <testExclude>**/YoloWorldInferenceTest.java</testExclude>
          </testExcludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <forkCount>1</forkCount>
          <reuseForks>false</reuseForks>
          <runOrder>alphabetical</runOrder>
          <argLine>--enable-preview --add-modules jdk.incubator.vector --add-opens java.base/jdk.internal.misc=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>default</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-jar-plugin</artifactId>
            <configuration>
              <excludes>
                <exclude>audio/**</exclude>
                <exclude>nlp/**</exclude>
              </excludes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- ONNX Runtime 执行引擎切换（cpu/gpu 互斥，配置 -P!cpu,gpu 或 -P!gpu,cpu）：
         - 默认 cpu：onnxruntime 1.21.1（CPU 版）
         - gpu：onnxruntime_gpu 1.27.0（内置 CPU+CUDA+TensorRT EP；启用 CUDA 需本机 CUDA 12
           运行时 cudart/cublas/cudnn9，见 utils-support-models-parent/libs/cuda）
           运行期由 DetectionConfiguration.useGpu(true) 触发 addCUDA()）。-->
    <profile>
      <id>cpu</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <dependencies>
        <dependency>
          <groupId>com.microsoft.onnxruntime</groupId>
       <artifactId>onnxruntime</artifactId>
       <version>1.30.0</version>
        </dependency>
    </dependencies>
    </profile>
    <profile>
      <id>gpu</id>
      <dependencies>
        <dependency>
          <groupId>com.microsoft.onnxruntime</groupId>
          <artifactId>onnxruntime_gpu</artifactId>
          <version>1.30.0</version>
        </dependency>
    </dependencies>
    </profile>
  </profiles>
  <dependencies>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
        </dependency>
