<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>utils-support-deeplearning-parent</artifactId>
        <version>4.0.0.42</version>
    </parent>
    <artifactId>utils-support-deeplearning-agentscope-starter</artifactId>
    <name>AgentScope Agent Starter</name>
    <description>AgentScope 实现，将项目通用 Agent 接入到 AgentScope Harness</description>
    <dependencies>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
            <version>2.0.3</version>
        </dependency>
        <!-- OpenAI Java SDK：ChatClientModelAdapter 使用 com.openai.* API（版本对齐根 pom dependencyManagement 4.63.1） -->
        <dependency>
            <groupId>com.openai</groupId>
            <artifactId>openai-java</artifactId>
        </dependency>
        <!-- openai-java 4.x 顶层 jar 为聚合 stub，实际类位于 openai-java-core / openai-java-client-okhttp，显式声明保证编译类路径完整 -->
        <dependency>
            <groupId>com.openai</groupId>
            <artifactId>openai-java-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.openai</groupId>
            <artifactId>openai-java-client-okhttp</artifactId>
        </dependency>
<dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
        </dependency>
    </dependencies>
    <dependencyManagement>
        <dependencies>
            <!-- Override slf4j to stable release (agentscope pulls 2.1.0-alpha1) -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>2.0.17</version>
            </dependency>
            <!-- Fix jackson version mismatch (jsr310 pulled 2.19.0, others are 2.21.4) -->
            <dependency>
                <groupId>com.fasterxml.jackson.datatype</groupId>
                <artifactId>jackson-datatype-jsr310</artifactId>
                <version>2.21.4</version>
            </dependency>
            <!-- Lock okhttp to single version (agentscope pulls both 4.x and 5.x) -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>4.12.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skipTests>false</skipTests>
                    <skipExec>false</skipExec>
                    <useSystemClassLoader>false</useSystemClassLoader>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
