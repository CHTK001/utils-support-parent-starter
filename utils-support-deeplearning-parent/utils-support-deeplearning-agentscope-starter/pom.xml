<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>utils-support-deeplearning-parent</artifactId>
        <version>4.0.0.42</version>
    </parent>
    <artifactId>utils-support-deeplearning-agentscope-starter</artifactId>
    <name>AgentScope Agent Starter</name>
    <description>AgentScope 实现，将项目通用 Agent 接入到 AgentScope Harness</description>
    <dependencies>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
            <version>2.0.3</version>
        </dependency>
        <!-- OpenAI Java SDK：ChatClientModelAdapter 使用 com.openai.* API（版本对齐根 pom dependencyManagement 4.63.1） -->
        <dependency>
            <groupId>com.openai</groupId>
            <artifactId>openai-java</artifactId>
        </dependency>
        <!-- openai-java 4.x 顶层 jar 为聚合 stub，实际类位于 openai-java-core / openai-java-client-okhttp，显式声明保证编译类路径完整 -->
        <dependency>
            <groupId>com.openai</groupId>
            <artifactId>openai-java-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.openai</groupId>
            <artifactId>openai-java-client-okhttp</artifactId>
        </dependency>
        <!-- AgentSubAgentRoutingTest 使用 JUnit 5 注解（@Test / @BeforeEach / @AfterEach），
             本模块原先未声明 junit，导致 testCompile 报「package org.junit.jupiter.api does not exist」。
             版本取全仓 junit-jupiter 主流值 5.13.0-M3（25 处），避免再引入新变体。 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.13.0-M3</version>
            <scope>test</scope>
        </dependency>
<dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
        </dependency>
    </dependencies>
    <dependencyManagement>
        <dependencies>
            <!--
              2026-09-28 原先此处有两条无版本覆盖条目（slf4j-api 钉 2.0.17、
              jackson-datatype-jsr310 钉 2.21.4），注释写明用意是压住 agentscope
              传递依赖拉进来的 slf4j 2.1.0-alpha1 与 jsr310 2.19.0。
              现父 POM 已在根上统一托管这两个坐标（slf4j-api=2.0.18、
              jackson-datatype-jsr310=2.21.4），本地覆盖已属冗余，故整条删除。

              注意：只删 version 会留下「无版本的 dependencyManagement 条目」，
              该条目会遮蔽父 POM 的托管值，使 jsr310 回落到传递依赖的 2.18.9，
              反而重新制造出 databind 2.21.4 / jsr310 2.18.9 的错配。
              要么给全版本，要么整条删除，不可只删 version。
            -->
            <!-- Lock okhttp to single version (agentscope pulls both 4.x and 5.x) -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>4.12.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skipTests>false</skipTests>
                    <skipExec>false</skipExec>
                    <useSystemClassLoader>false</useSystemClassLoader>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
