<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>utils-support-deeplearning-parent</artifactId>
        <version>4.0.0.51</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>utils-support-deeplearning-jitllm-starter</artifactId>
    <name>Utils Support Deep Learning JitLLM Starter</name>
    <description>jitLLM GPU 大模型推理集成：基于 beehive-lab jitllm（TornadoVM GPU 加速）加载 GGUF 模型，提供本地 LLM 对话、流式输出与用量统计（SPI provider="jitllm"）</description>
    <dependencies>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- jitllm：GGUF 模型在 JVM 内的 GPU 推理引擎， shaded fat jar；
             jdk22plus 变体适配本项目 Java 25，运行需 TornadoVM 原生库与 GPU/后端环境 -->
        <dependency>
            <groupId>io.github.beehive-lab</groupId>
            <artifactId>jitllm</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- deeplearning 契约：AbstractLocalChatClient / ModelRegistry / ITranslator（原 gpu-llama3 能力迁入） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-deeplearning-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- llama.cpp 绑定：GGUF 进程内推理（原 gpu-llama3 能力迁入），需 CUDA/GPU 环境 -->
        <dependency>
            <groupId>de.kherud</groupId>
            <artifactId>llama</artifactId>
            <version>4.2.0</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
