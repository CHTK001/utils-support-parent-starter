# ============================================
# Neo4j Cypher 方言配置
# 文件：META-INF/dialect-env/neo4j.env
# ============================================

protocol=neo4j
driver=org.neo4j.driver.Driver
url=bolt://<IP>:<PORT>
query-lang=cypher

# Neo4j 支持原生分页（SKIP...LIMIT）
supports-native-pagination=true
supports-limit=true

# Cypher 分页模板：在 MATCH 查询末尾追加 SKIP/LIMIT
pagination-sql={sql} SKIP {offset} LIMIT {limit}

# 实体标签默认从类名派生，此处不覆盖
