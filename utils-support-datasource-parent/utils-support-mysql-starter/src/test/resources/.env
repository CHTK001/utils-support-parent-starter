# MySQL 集成测试连接配置，可覆盖到项目根目录或系统环境变量
# 优先级：Java -D 系统属性 > 环境变量 > .env 文件 > 硬编码默认值

# 测试库基础名称（拼接 _meta / _db 后缀区分不同测试类）
TEST_DB_PREFIX=jdbc_engine_test
# 测试用户前缀
TEST_USER_PREFIX=engine_test

# ---- 管理账号（用于建库、授权等权限操作）----
ADMIN_HOST=172.16.0.40
ADMIN_PORT=3308
ADMIN_USER=root
ADMIN_PASS=root
# ---- 只读/业务账号 ----
APP_USER=app_user
APP_PASS=app_pass
