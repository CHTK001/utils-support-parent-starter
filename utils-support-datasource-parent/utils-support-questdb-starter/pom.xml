<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>utils-support-datasource-parent</artifactId>
        <version>4.0.0.42</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>utils-support-questdb-starter</artifactId>
    <name>QuestDB Starter</name>
    <description>QuestDB 时序数据库集成：写入基于官方 Sender（ILP over HTTP），查询/指标发现/保留期清理经 HTTP /exec，提供 SeriesEngine 时序引擎实现</description>
    <dependencies>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-datasource-starter</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- QuestDB 官方 Java 客户端：内含 ILP over HTTP/TCP Sender，无运行期传递依赖 -->
        <dependency>
            <groupId>org.questdb</groupId>
            <artifactId>questdb</artifactId>
        </dependency>

        <!-- 解析 QuestDB HTTP /exec 返回的 JSON（版本由 spring-boot-dependencies BOM 统一管理） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.13.0-M3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- QuestDB Sender / JDK HttpClient 存在非守护线程，测试完成后需强制回收 fork 进程 -->
                    <forkedProcessExitTimeoutInSeconds>15</forkedProcessExitTimeoutInSeconds>
                    <surefire.timeout>120</surefire.timeout>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
