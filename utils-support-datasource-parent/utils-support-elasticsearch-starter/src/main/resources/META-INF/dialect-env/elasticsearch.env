# ============================================
# Elasticsearch 方言配置
# 文件：META-INF/dialect-env/elasticsearch.env
# ============================================

protocol=elasticsearch
driver=
url=http://<IP>:<PORT>
query-lang=es

# ES 不支持 SQL 式分页，依赖 Java 内存截取
# from/size 在 ES 5.x+ 有 10000 结果限制，深度分页需用 scroll/cursor
supports-native-pagination=false
supports-limit=false

# ES 原生聚合分页配置（可选，用于 aggregation 场景）
aggregation-page-size=10
max-result-window=10000
