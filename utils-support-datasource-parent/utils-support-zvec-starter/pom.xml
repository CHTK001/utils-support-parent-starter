<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>utils-support-datasource-parent</artifactId>
        <version>4.0.0.51</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>utils-support-zvec-starter</artifactId>
    <name>Zvec Starter</name>
    <description>Zvec 嵌入式向量数据库 ORM（zvec-java JNI 绑定）</description>
    <dependencies>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
        </dependency>

        <!--
            Zvec 官方 Java 绑定：JavaCPP/JNI 封装 zvec C API，主 JAR 内置
            windows-x86_64 / linux-x86_64 / linux-arm64 / macosx-arm64 / macosx-x86_64
            各平台原生库，运行时按当前平台自动解压加载，无需外部安装向量库服务。
            传递依赖 org.bytedeco:javacpp:1.5.14；宿主若已引入其他 bytedeco 组件，
            需确认 javacpp 版本仲裁后仍 ≥ 1.5.14，否则原生加载可能失败。
        -->
        <dependency>
            <groupId>org.zvec</groupId>
            <artifactId>zvec-java</artifactId>
            <version>0.8.0</version>
        </dependency>
    </dependencies>
</project>
