# ============================================
# GreptimeDB 方言配置（MySQL 兼容 SQL，gRPC/HTTP 客户端）
# 对应类：GreptimeDialect
# 文件：META-INF/dialect-env/greptime.env
# ============================================

# --- 基础标识 ---
protocol=greptime
driver=greptime
url=

# --- 引用符（MySQL 兼容反引号） ---
quote-open=`
quote-close=`

# --- 自增 / 引擎：Greptime 无 AUTO_INCREMENT 与存储引擎概念，均不配置 ---

# --- 分页：Greptime 原生支持 LIMIT n OFFSET m，无需自定义模板 ---
supports-limit=true
supports-offset=true

# --- DDL/DML ---
alter-column-string=ALTER COLUMN
# Greptime 不支持 ON DUPLICATE KEY UPDATE 语法
supports-upsert=false
supports-inline-comment=true
supports-vector=false
supports-json=false

# --- 时间戳 ---
current-timestamp-sql=SELECT NOW()

# --- JDBC 类型映射 ---
type.BIGINT=BIGINT
type.BINARY=VARBINARY
type.BIT=BOOLEAN
type.BLOB=VARBINARY
type.BOOLEAN=BOOLEAN
type.CHAR=CHAR({len})
type.CLOB=STRING
type.DATE=DATE
type.DATETIME=TIMESTAMP
type.DECIMAL=DECIMAL
type.DOUBLE=DOUBLE
type.FLOAT=FLOAT
type.INTEGER=INT
type.LONGNVARCHAR=STRING
type.LONGVARCHAR=STRING
type.NUMERIC=DECIMAL
type.REAL=FLOAT
type.SMALLINT=SMALLINT
type.TIME=TIME
type.TIMESTAMP=TIMESTAMP
type.TINYINT=TINYINT
type.VARBINARY=VARBINARY
type.VARCHAR=VARCHAR({len})
type.JSON=STRING
type.UUID=STRING
type.JAVA_OBJECT=STRING
