<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>utils-support-datasource-parent</artifactId>
        <version>4.0.0.42</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>utils-support-greptimedb-starter</artifactId>
    <name>GreptimeDB Starter</name>
    <description>GreptimeDB 时序数据库 Ingester 集成模块，基于 gRPC SDK 提供 Engine 引擎与高性能写入能力</description>

    <dependencies>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-datasource-starter</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>io.greptime</groupId>
            <artifactId>ingester-all</artifactId>
            <version>0.15.0</version>
            <exclusions>
                <!--
                    排除 arrow-memory-netty（其反射读取 PoolArena.chunkSize，
                    该字段在项目统一的 Netty 4.2 中已移除）。
                    改用下方 arrow-memory-unsafe 分配器（不依赖 Netty），
                    从而使全工程统一使用 Netty 4.2.15。
                -->
                <exclusion>
                    <groupId>org.apache.arrow</groupId>
                    <artifactId>arrow-memory-netty</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Arrow 堆外内存分配器（Unsafe 实现，无 Netty 依赖），替代 arrow-memory-netty -->
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-memory-unsafe</artifactId>
            <version>14.0.2</version>
        </dependency>

        <!--
            查询/删除通道：官方文档首推使用 MySQL 协议成熟驱动查询 GreptimeDB(4002 端口)。
            版本由根 parent dependencyManagement 统一管理（9.3.0）。
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!--
            固定 protobuf-java 版本（取 GreptimeDB SDK 自身 dependencyManagement 的 3.25.1）。
            项目传递引入的 4.31.1 会使 GreptimeDB proto 抛 'NoSuchMethodError: makeExtensionsImmutable()'；
            而 3.21.12 又缺少 Arrow Flight 14 生成代码所需的 LazyStringArrayList.emptyList()。
            3.25.1 同时兼容两者。
        -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>3.25.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Arrow Unsafe 堆外分配器在 JDK9+ 需要打开 java.nio 模块（Arrow 官方要求） -->
                    <argLine>--add-opens=java.base/java.nio=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
