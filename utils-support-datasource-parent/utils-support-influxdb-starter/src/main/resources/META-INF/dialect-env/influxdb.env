# ============================================
# InfluxDB 时序数据库方言配置
# 文件：META-INF/dialect-env/influxdb.env
# ============================================

protocol=influxdb
driver=
url=http://<IP>:<PORT>
query-lang=influxql

# InfluxDB 支持 LIMIT（InfluxQL），不支持 OFFSET
supports-native-pagination=true
supports-limit=true

# InfluxQL 分页：追加 LIMIT n
pagination-sql={sql} LIMIT {limit}
# 注意：InfluxDB 1.x 无 OFFSET，超出部分由内存截取兜底

# 实体表名默认映射
table-name-template={entity_class}
