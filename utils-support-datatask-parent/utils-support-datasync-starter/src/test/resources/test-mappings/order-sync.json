{
  "mappingId": "core-order-sync",
  "inputId": "order-input",
  "sourceId": "order-source",
  "outputId": "order-output",
  "sinkId": "order-sink",
  "batch": 10,
  "cronType": "fixed",
  "cron": "0/5 * * * * ?",
