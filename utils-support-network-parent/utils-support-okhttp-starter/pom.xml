<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>utils-support-network-parent</artifactId>
        <version>4.0.0.51</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>utils-support-okhttp-starter</artifactId>
    <name>Utils Support OkHttp Starter</name>
    <description>OkHttp3 HTTP 客户端执行器 SPI 实现</description>
    <dependencies>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>${okhttp.version}</version>
        </dependency>
        <!-- okhttp 5.x 的 okhttp 构件是 KMP 空壳（真实 okhttp3 类在 okhttp-jvm，见根 pom 依赖管理）。
             本模块源码直接使用 OkHttpClient/Request/Response 等 okhttp3 类，必须显式依赖 okhttp-jvm，
             不能依赖传递兜底（同 xunfei/3d-starter 口径）。 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-jvm</artifactId>
        </dependency>
    </dependencies>
</project>
