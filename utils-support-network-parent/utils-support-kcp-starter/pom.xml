<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>utils-support-network-parent</artifactId>
        <version>4.0.0.42</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>utils-support-kcp-starter</artifactId>
    <name>Utils Support Kcp Starter</name>
    <description>KCP 可靠 UDP 传输集成：基于 com.github.l42111996:kcp-base (Java KCP over Netty) 实现 KcpServer 消息服务器与 KcpClient 请求-响应客户端。</description>
    <properties>
        <kcp.base.version>1.6.2</kcp.base.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
        kcp-base 1.6.2 内部使用 NioEventLoopGroup, kcp-fec 依赖 netty-all。
        与项目统一 netty 4.2 共存可能存在 API 差异，
        故显式 exclusion kcp-fec 的 netty-all, 由 oauth/上游统一注入 netty 4.2 模块。
        -->
        <dependency>
            <groupId>com.github.l42111996</groupId>
            <artifactId>kcp-base</artifactId>
            <version>${kcp.base.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>com.github.l42111996</groupId>
                    <artifactId>kcp-fec</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-all</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 显式声明 kcp-fec (排除 netty-all, 改用项目统一 netty 4.2 模块) -->
        <dependency>
            <groupId>com.github.l42111996</groupId>
            <artifactId>kcp-fec</artifactId>
            <version>${kcp.base.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-all</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- kcp-base 内部使用 netty.buffer/Channel/EventLoop 等, 显式引入项目统一 netty 4.2 模块 -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-buffer</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-common</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-classes-epoll</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lmax</groupId>
            <artifactId>disruptor</artifactId>
            <version>3.4.4</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.jctools</groupId>
            <artifactId>jctools-core</artifactId>
            <version>3.3.0</version>
        </dependency>
        <!-- kcp-base 1.6.2(AbstractKcpServer) 静态引用 io.netty.channel.kqueue.KQueue，补齐 netty 4.2 的 kqueue 类 -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-classes-kqueue</artifactId>
            <version>4.2.15.Final</version>
        </dependency>
    </dependencies>
</project>