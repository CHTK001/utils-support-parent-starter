<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>utils-support-network-parent</artifactId>
        <version>4.0.0.51</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>utils-support-retrofit-starter</artifactId>
    <name>Utils Support Retrofit Starter</name>
    <description>Retrofit2 HTTP 客户端调用器 SPI 实现</description>
    <dependencies>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.squareup.retrofit2</groupId>
            <artifactId>retrofit</artifactId>
        </dependency>
        <dependency>
            <groupId>com.squareup.retrofit2</groupId>
            <artifactId>converter-jackson</artifactId>
        </dependency>
        <!-- okhttp 5.x 的 okhttp 构件是 KMP 空壳（真实 okhttp3 类在 okhttp-jvm，见根 pom 依赖管理）。
             retrofit / converter-jackson 的 API 签名暴露 okhttp3 类型（如 ResponseBody），编译期
             需要真实 okhttp3 类，必须显式依赖 okhttp-jvm（同 xunfei / 3d-starter / okhttp-starter 口径）。 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-jvm</artifactId>
        </dependency>
    </dependencies>
</project>