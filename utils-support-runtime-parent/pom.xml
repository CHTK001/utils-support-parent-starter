<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.chua</groupId>
    <artifactId>utils-support-runtime-parent</artifactId>
    <version>4.0.0.42</version>
    <packaging>pom</packaging>

    <parent>
        <groupId>com.chua</groupId>
        <artifactId>utils-support-parent-starter</artifactId>
        <version>4.0.0.42</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <name>Utils Support Runtime Parent</name>
    <description>运行时管理：core(接口)/spy(字节码)/agent(agent入口)/starter(主入口+依赖)</description>

    <modules>
        <module>utils-support-runtime-core</module>
        <module>utils-support-runtime-plugin</module>
        <module>utils-support-runtime-spy</module>
        <module>utils-support-runtime-apm</module>
        <module>utils-support-runtime-agent</module>
        <module>utils-support-runtime-shell</module>
        <module>utils-support-runtime-starter</module>
        <module>utils-support-runtime-protocol</module>
        <module>utils-support-runtime-e2e-test</module>
        <module>utils-support-runtime-agent-demo</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>
</project>