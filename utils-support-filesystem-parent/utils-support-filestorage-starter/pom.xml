<?xml version='1.0' encoding='utf-8'?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>utils-support-filesystem-parent</artifactId>
        <version>4.0.0.42</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <groupId>com.chua</groupId>
    <artifactId>utils-support-filestorage-starter</artifactId>
    <version>4.0.0.42</version>
    <packaging>jar</packaging>
    <name>Utils Support FileStorage Starter</name>
    <description>文件存储基础模块，提供文件存储服务器过滤器、配置及 SPI 扩展</description>
     <dependencies>
         <dependency>
             <groupId>org.projectlombok</groupId>
             <artifactId>lombok</artifactId>
             <version>${lombok.version}</version>
             <scope>provided</scope>
         </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-image-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>${commons.compress.version}</version>
        </dependency>
         <!-- optional: Rust native 实现（更高性能）。
              类 com.chua.filestorage.support.bridge.RustFileStorageBridge 由 native-filestorage 提供，
              NativeFileStorageFilterSetting/NativeFileStorageFileSetting 通过 isInitialized() 守卫调用。
              当前 native-filestorage 源码模块未检出，保持 provided 避免编译期拉取；
              运行时若需启用 Rust 加速，请显式引入 utils-support-native-filestorage。 -->
         <dependency>
             <groupId>com.chua</groupId>
             <artifactId>utils-support-native-filestorage</artifactId>
             <version>${project.version}</version>
             <scope>provided</scope>
         </dependency>
     </dependencies>
</project>
