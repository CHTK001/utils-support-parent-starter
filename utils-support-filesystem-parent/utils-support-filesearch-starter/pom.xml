<?xml version='1.0' encoding='utf-8'?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>utils-support-filesystem-parent</artifactId>
        <version>4.0.0.42</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <groupId>com.chua</groupId>
    <artifactId>utils-support-filesearch-starter</artifactId>
    <version>4.0.0.42</version>
    <packaging>jar</packaging>
    <name>Utils Support Filesearch Starter</name>
    <description>文件搜索引擎模块，基于 Rust 原生库 + Java 25 FFM</description>
    <dependencies>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-filesystem-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- RustFileSearchBridge JNI 绑定已迁入 native 模块，包名仍为
             com.chua.filesearch.support.bridge（原生符号写死了该全限定名）。
             本模块此前未声明任何 native 依赖，native 库实际不在 classpath 上；
             绑定迁出后必须显式声明，否则编译期找不到该类。
             注：同包的 RustFileSearchHelper（含 JDK walkdir 降级）仍留在本模块，
             故该包在两个 jar 间分裂（split package）。无 module-info，classpath
             模式下合法。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-native-filesearch</artifactId>
            <version>${project.version}</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>
</project>
