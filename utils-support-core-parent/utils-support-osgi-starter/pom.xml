<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>utils-support-core-parent</artifactId>
        <version>4.0.0.42</version>
        <relativePath>../../utils-support-core-parent/pom.xml</relativePath>
    </parent>
    <artifactId>utils-support-osgi-starter</artifactId>
    <name>Utils Support Osgi Starter - OSGI                  </name>
    <description>
        Utils Support OSGI Starter - Apache Felix Framework              
    </description>
    <properties>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <felix.version>7.0.5</felix.version>
        <felix.gogo.runtime.version>1.1.6</felix.gogo.runtime.version>
        <felix.gogo.shell.version>1.1.4</felix.gogo.shell.version>
        <felix.gogo.command.version>1.1.2</felix.gogo.command.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 源码扩展点热重载（SourceJavaCompiler / SourceGroovyLoader / SourceExtensionScheduler）的真实行为测试。
             不引入 mockito：这些用例依赖的是真实 JDK 编译器与真实 SPI 注册表，
             打桩反而测不到「注册表里到底存了什么」这个关键点。 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>

        <!-- Groovy 引擎 + GroovyScriptProvider。生产依赖里本模块<b>不</b>引入 groovy：
             SourceGroovyLoader 靠 ScriptProviders.resolve 探测引擎是否可用，
             缺失时降级为「只支持 Java 源码」。放 test 作用域是为了让
             groovy 那条代码路径真正被执行到，而不是永远未被覆盖。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-groovy-starter</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.felix</groupId>
            <artifactId>org.apache.felix.framework</artifactId>
            <version>${felix.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.felix</groupId>
            <artifactId>org.apache.felix.main</artifactId>
            <version>${felix.version}</version>
        </dependency>

        <!-- Gogo shell 套件（telnet 远程管理） -->
        <dependency>
            <groupId>org.apache.felix</groupId>
            <artifactId>org.apache.felix.gogo.runtime</artifactId>
            <version>${felix.gogo.runtime.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.felix</groupId>
            <artifactId>org.apache.felix.gogo.command</artifactId>
            <version>${felix.gogo.command.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.felix</groupId>
            <artifactId>org.apache.felix.gogo.shell</artifactId>
            <version>${felix.gogo.shell.version}</version>
        </dependency>

        <!-- Apache SSHD OSGi bundle（SSH 远程管理，优先于 telnet） -->
        <!-- 注意：必须先装 sshd-core，再装 sshd-osgi/sshd-sftp/sshd-scp -->
        <dependency>
            <groupId>org.apache.sshd</groupId>
            <artifactId>sshd-core</artifactId>
            <version>${sshd.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.sshd</groupId>
            <artifactId>sshd-osgi</artifactId>
            <version>${sshd.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.sshd</groupId>
            <artifactId>sshd-sftp</artifactId>
            <version>${sshd.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.sshd</groupId>
            <artifactId>sshd-scp</artifactId>
            <version>${sshd.version}</version>
        </dependency>

        <dependency>
            <groupId>io.github.classgraph</groupId>
            <artifactId>classgraph</artifactId>
        </dependency>

    </dependencies>
</project>

