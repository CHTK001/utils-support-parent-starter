# ============================================================================
# CUDA 运行时库配置（classpath 资源，Java 侧读取；scripts/.env 供脚本本地使用）
# 所有路径/版本/URL 均在此声明，代码禁止硬编码
# ============================================================================

# 目标 CUDA 主版本（onnxruntime-gpu 1.21+ 需要 CUDA 12 + cuDNN 9）
CUDA_MAJOR=12

# 配套 onnxruntime-gpu 版本（信息性校验）
ORT_VERSION=1.27.0

# CUDA 运行库目标目录（相对 native-cuda 模块根目录）
TARGET_DIR=libs/cuda

# 安装脚本名（按平台选择；位于 native-cuda 模块 scripts/ 下）
SCRIPT_WINDOWS=setup-cuda.bat
SCRIPT_LINUX=setup-cuda.sh
SCRIPT_MACOS=setup-cuda-macos.sh

# 下载超时（秒）
DOWNLOAD_TIMEOUT_SEC=600

# 是否在安装完成后提示加入 PATH / LD_LIBRARY_PATH
AUTO_PATH=true
