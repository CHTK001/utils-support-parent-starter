<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>utils-support-core-parent</artifactId>
        <version>4.0.0.51</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>utils-support-datasource-starter</artifactId>
    <name>Utils Support Datasource Starter</name>
    <description>数据源核心引擎：AbstractEngine、JdbcEngine、MemoryWhereParser、Lambda 包装器</description>
    <properties>
        <mssql-jdbc.version>12.6.1.jre11</mssql-jdbc.version>
        <jtds.version>1.3.1</jtds.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>
        <!-- R2DBC 规范接口：引擎编译期仅依赖 SPI，具体驱动由各数据库 starter 提供 -->
        <dependency>
            <groupId>io.r2dbc</groupId>
            <artifactId>r2dbc-spi</artifactId>
            <version>0.9.1.RELEASE</version>
        </dependency>
        <!-- Test dependencies -->
        <!-- 内存型 JDBC 数据库：JDBC 引擎链路（物理分页 / 原生 SQL / 类型映射）验收用 -->
        <!-- H2 的 R2DBC 驱动：响应式 JDBC 引擎（真非阻塞路径）验收用 -->
        <!-- SQL 解析器 -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
            <version>5.4</version>
            <scope>provided</scope>
        </dependency>
        <!-- 单元测试 -->
    </dependencies>
</project>
