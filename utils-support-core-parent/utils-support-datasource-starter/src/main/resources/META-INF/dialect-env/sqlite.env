# ============================================
# SQLite 3.x 方言配置
# 文件：META-INF/dialect-env/sqlite.env
# ============================================

protocol=sqlite
driver=org.sqlite.JDBC
url=jdbc:sqlite:<DATABASE>
quote-open="
quote-close="

auto-increment-keyword=AUTOINCREMENT
supports-upsert=true
upsert-template=insert into {table} ({columns}) values ({values}) on conflict ({conflict}) do update set {updateSet}
supports-inline-comment=false
supports-partition=false
supports-vector=false
supports-json=true
alter-column-string=

current-timestamp-sql=SELECT datetime('now')

# SQLite 是动态类型，几乎所有 JDBC 类型都映射到 TEXT/INTEGER/REAL/BLOB
type.BIGINT=INTEGER
type.BINARY=BLOB
type.BIT=INTEGER
type.BLOB=BLOB
type.BOOLEAN=INTEGER
type.CHAR=TEXT
type.CLOB=TEXT
type.DATE=TEXT
type.DECIMAL=REAL
type.DOUBLE=REAL
type.FLOAT=REAL
type.INTEGER=INTEGER
type.LONGNVARCHAR=TEXT
type.LONGVARCHAR=TEXT
type.NUMERIC=REAL
type.REAL=REAL
type.SMALLINT=INTEGER
type.TIME=TEXT
type.TIMESTAMP=TEXT
type.TINYINT=INTEGER
type.VARBINARY=BLOB
type.VARCHAR=TEXT

# SQLite 触发器在 sqlite_master 中
trigger-list-sql=SELECT name AS TRIGGER_NAME, tbl_name AS TABLE_NAME, sql AS ACTION_STATEMENT FROM sqlite_master WHERE type = 'trigger'
trigger-sql=SELECT name AS TRIGGER_NAME, tbl_name AS TABLE_NAME, sql AS ACTION_STATEMENT FROM sqlite_master WHERE type = 'trigger' AND name = '{trigger_name}'

pagination-sql={sql} LIMIT {limit}{offset_clause}
# offset_clause 由 SqlDialect 处理：有 offset 时追加 OFFSET {offset}
