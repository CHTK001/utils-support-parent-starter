# ============================================
# DuckDB 方言配置
# 文件：META-INF/dialect-env/duckdb.env
# ============================================

protocol=duckdb
driver=org.duckdb.DuckDBDriver
url=jdbc:duckdb:<DATABASE>
quote-open="
quote-close="

auto-increment-keyword=AUTO_INCREMENT
alter-column-string=ALTER COLUMN
supports-upsert=false
supports-inline-comment=false
supports-partition=false
supports-vector=false
supports-json=true

current-timestamp-sql=SELECT CURRENT_TIMESTAMP

type.BIGINT=BIGINT
type.BINARY=BLOB
type.BIT=BOOLEAN
type.BLOB=BLOB
type.BOOLEAN=BOOLEAN
type.CHAR=CHAR(255)
type.CLOB=CLOB
type.DATE=DATE
type.DECIMAL=DECIMAL({prec},{scl})
type.DOUBLE=DOUBLE
type.FLOAT=FLOAT
type.INTEGER=INTEGER
type.LONGNVARCHAR=VARCHAR
type.LONGVARCHAR=VARCHAR
type.NUMERIC=DECIMAL({prec},{scl})
type.REAL=FLOAT
type.SMALLINT=SMALLINT
type.TIME=TIME
type.TIMESTAMP=TIMESTAMP
type.TINYINT=TINYINT
type.VARBINARY=BLOB
type.VARCHAR=VARCHAR

get-index-template=CREATE {unique}INDEX {name} ON {table} ({columns})
drop-index-template=DROP INDEX IF EXISTS {index}
rename-index-template=ALTER INDEX {old} RENAME TO {new}
