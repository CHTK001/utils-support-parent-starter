# ============================================
# Oracle 19c+ 方言配置
# 文件：META-INF/dialect-env/oracle.env
# ============================================

protocol=oracle
driver=oracle.jdbc.OracleDriver
url=jdbc:oracle:thin:@<IP>:<PORT>:<DATABASE>

quote-open="
quote-close="

auto-increment-keyword=GENERATED BY DEFAULT AS IDENTITY
alter-column-string=MODIFY
supports-upsert=true
upsert-template=MERGE INTO {table} USING DUAL ON (1=0) WHEN NOT MATCHED THEN INSERT ({columns}) VALUES ({values})
supports-inline-comment=false
supports-partition=false

table-comment=
column-comment=
current-timestamp-sql=SELECT SYSDATE FROM DUAL

type.BIGINT=NUMBER(19)
type.BINARY=RAW(2000)
type.BIT=NUMBER(1)
type.BLOB=BLOB
type.BOOLEAN=NUMBER(1)
type.CHAR=CHAR(255)
type.CLOB=CLOB
type.DATE=DATE
type.DECIMAL=NUMBER(10,0)
type.DOUBLE=FLOAT
type.FLOAT=BINARY_FLOAT
type.INTEGER=NUMBER(10)
type.LONGNVARCHAR=CLOB
type.LONGVARCHAR=CLOB
type.NUMERIC=NUMBER(10,0)
type.REAL=BINARY_FLOAT
type.SMALLINT=NUMBER(5)
type.TIME=TIMESTAMP
type.TIMESTAMP=TIMESTAMP
type.TINYINT=NUMBER(3)
type.VARBINARY=RAW(2000)
type.VARCHAR=VARCHAR2(255 CHAR)

pagination-sql=SELECT * FROM (SELECT TMP.*, ROWNUM ROW_ID FROM ({sql}) TMP WHERE ROWNUM <= {offset} + {limit}) WHERE ROW_ID > {offset}

write-lock-template= FOR UPDATE WAIT {timeout}

trigger-list-sql=SELECT TRIGGER_NAME AS TRIGGER_NAME, OWNER AS TRIGGER_SCHEMA, TABLE_NAME AS TABLE_NAME, TRIGGER_TYPE AS ACTION_TIMING, TRIGGERING_EVENT AS EVENT_MANIPULATION, STATUS AS STATUS, TRIGGER_BODY AS ACTION_STATEMENT FROM ALL_TRIGGERS
trigger-sql=SELECT * FROM ({list_sql}) T WHERE TRIGGER_NAME = '{trigger_name}'
procedure-list-sql=SELECT OWNER AS ROUTINE_SCHEMA, OBJECT_NAME AS ROUTINE_NAME, OBJECT_TYPE AS ROUTINE_TYPE, STATUS AS STATUS, (SELECT LISTAGG(s.TEXT, '') WITHIN GROUP (ORDER BY s.LINE) FROM ALL_SOURCE s WHERE s.OWNER = o.OWNER AND s.NAME = o.OBJECT_NAME AND s.TYPE = o.OBJECT_TYPE) AS ROUTINE_DEFINITION FROM ALL_OBJECTS o WHERE o.OBJECT_TYPE IN ('PROCEDURE', 'FUNCTION')
procedure-sql=SELECT * FROM ({list_sql}) T WHERE ROUTINE_NAME = '{procedure_name}'

schema-condition-template= AND {column} = UPPER('{value}')
