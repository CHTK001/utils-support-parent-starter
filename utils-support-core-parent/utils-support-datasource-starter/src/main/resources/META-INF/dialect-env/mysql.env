# MySQL 方言默认配置
# 覆盖方式：application.properties 或构造时传入 Properties，优先级高于本文件
#
# 引用符
quote-open=`
quote-close=`
#
# 驱动与连接
driver=com.mysql.cj.jdbc.Driver
#
# JDBC 类型映射（key = java.sql.Types 常量名）
type.BIGINT=BIGINT
type.BINARY=BINARY
type.BIT=BIT
type.BLOB=BLOB
type.BOOLEAN=TINYINT(1)
type.CHAR=CHAR(255)
type.CLOB=TEXT
type.DATE=DATE
type.DECIMAL=DECIMAL(10,0)
type.DOUBLE=DOUBLE
type.FLOAT=FLOAT
type.INTEGER=INT
type.LONGNVARCHAR=TEXT
type.LONGVARCHAR=TEXT
type.NUMERIC=DECIMAL(10,0)
type.REAL=REAL
type.SMALLINT=SMALLINT
type.TIME=TIME
type.TIMESTAMP=DATETIME
type.TINYINT=TINYINT
type.VARBINARY=VARBINARY(255)
type.VARCHAR=VARCHAR(255)
#
# DDL / DML 关键字
auto-increment-keyword=AUTO_INCREMENT
alter-column-string=MODIFY COLUMN
current-timestamp-sql=SELECT NOW()
engine-keyword=ENGINE
table-type= ENGINE=InnoDB DEFAULT CHARSET=utf8mb4
#
# UPSERT
upsert-template=insert into {table} ({columns}) values ({values}) on duplicate key update {updateSet}
#
# 触发器查询模板（不支持时返回 null，使用 INFORMATION_SCHEMA 默认 SQL）
# trigger-list-sql=
# trigger-sql=
#
# 存储过程查询模板
# procedure-list-sql=
# procedure-sql=
