# ============================================
# MySQL 8.0+ 方言配置（兼容 5.7）
# 对应类：MysqlDialect / Mysql57Dialect
# 文件：META-INF/dialect-env/mysql.env
# ============================================

# --- 基础标识 ---
protocol=mysql
driver=com.mysql.cj.jdbc.Driver
url=

# --- 引用符 ---
quote-open=`
quote-close=`

# --- 分页（MySQL 原生 LIMIT/OFFSET 已内置，此处为自定义模板示例） ---
# pagination-sql={sql} LIMIT {limit} OFFSET {offset}

# --- 自增 / 引擎 ---
auto-increment-keyword=AUTO_INCREMENT
engine-keyword=ENGINE
storage-engine=INNODB
table-type= ENGINE=InnoDB DEFAULT CHARSET=utf8mb4
table-comment= COMMENT '{comment}'
column-comment= COMMENT '{comment}'

# --- DDL/DML ---
alter-column-string=MODIFY COLUMN
supports-upsert=true
upsert-template=insert into {table} ({columns}) values ({values}) on duplicate key update {updateSet}
supports-inline-comment=true
supports-partition=true

# --- 时间戳 ---
current-timestamp-sql=SELECT NOW()

# --- 向量 / JSON ---
supports-vector=true
supports-json=true

# --- JDBC 类型映射 ---
type.BIGINT=BIGINT
type.BINARY=BLOB
type.BIT=BIT
type.BLOB=BLOB
type.BOOLEAN=TINYINT(1)
type.CHAR=CHAR({len})
type.CLOB=TEXT
type.DATE=DATE
type.DECIMAL=DECIMAL(10,0)
type.DOUBLE=DOUBLE
type.FLOAT=FLOAT
type.INTEGER=INT
type.LONGNVARCHAR=TEXT
type.LONGVARCHAR=TEXT
type.NUMERIC=DECIMAL(10,0)
type.REAL=REAL
type.SMALLINT=SMALLINT
type.TIME=TIME
type.TIMESTAMP=DATETIME(3)
type.TINYINT=TINYINT
type.VARBINARY=VARBINARY(255)
type.VARCHAR=VARCHAR(255)

# --- 触发器查询 ---
trigger-list-sql=SELECT TRIGGER_NAME, TRIGGER_SCHEMA, EVENT_OBJECT_TABLE AS TABLE_NAME, ACTION_TIMING, EVENT_MANIPULATION, ACTION_STATEMENT, STATUS FROM INFORMATION_SCHEMA.TRIGGERS
trigger-sql=SELECT * FROM ({list_sql}) T WHERE TRIGGER_NAME = '{trigger_name}'

# --- 存储过程查询 ---
procedure-list-sql=SELECT ROUTINE_SCHEMA, ROUTINE_NAME, ROUTINE_TYPE, DATA_TYPE, ROUTINE_DEFINITION, ROUTINE_COMMENT, SECURITY_TYPE, ROUTINE_BODY, STATUS FROM INFORMATION_SCHEMA.ROUTINES WHERE ROUTINE_TYPE IN ('PROCEDURE', 'FUNCTION')
procedure-sql=SELECT * FROM ({list_sql}) T WHERE ROUTINE_NAME = '{procedure_name}'

# --- Schema 条件模板 ---
schema-condition-template= AND {column} = '{value}'
