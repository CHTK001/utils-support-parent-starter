# ============================================
# SQL Server 2008 方言配置
# 文件：META-INF/dialect-env/sqlserver2008.env
# ============================================

protocol=sqlserver2008
driver=com.microsoft.sqlserver.jdbc.SQLServerDriver
url=jdbc:sqlserver://<IP>:<PORT>;databaseName=<DATABASE>;encrypt=false
quote-open="
quote-close="

auto-increment-keyword=IDENTITY(1,1)
alter-column-string=ALTER COLUMN
supports-upsert=false
supports-inline-comment=false
supports-partition=false

current-timestamp-sql=SELECT GETDATE()

type.BIGINT=BIGINT
type.BINARY=VARBINARY(255)
type.BIT=BIT
type.BLOB=IMAGE
type.BOOLEAN=BIT
type.CHAR=NCHAR(255)
type.CLOB=TEXT
type.DATE=DATE
type.DECIMAL=DECIMAL(10,0)
type.DOUBLE=FLOAT
type.FLOAT=REAL
type.INTEGER=INT
type.LONGNVARCHAR=NTYPE
type.LONGVARCHAR=TEXT
type.NUMERIC=DECIMAL(10,0)
type.REAL=REAL
type.SMALLINT=SMALLINT
type.TIME=TIME
type.TIMESTAMP=DATETIME
type.TINYINT=TINYINT
type.VARBINARY=VARBINARY(255)
type.VARCHAR=VARCHAR(255)

pagination-sql={sql} OFFSET {offset} ROWS FETCH NEXT {limit} ROWS ONLY

schema-condition-template= AND {column} = '{value}'
