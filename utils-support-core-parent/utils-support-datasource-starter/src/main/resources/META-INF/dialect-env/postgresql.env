# PostgreSQL 方言默认配置
# 覆盖方式：application.properties 或构造时传入 Properties，优先级高于本文件
#
# 引用符
quote-open="
quote-close="
#
# 驱动与连接
driver=org.postgresql.Driver
#
# JDBC 类型映射（key = java.sql.Types 常量名）
type.BIGINT=BIGINT
type.BINARY=BYTEA
type.BIT=BOOLEAN
type.BLOB=BYTEA
type.BOOLEAN=BOOLEAN
type.CHAR=CHAR(255)
type.CLOB=TEXT
type.DATE=DATE
type.DECIMAL=NUMERIC(10,0)
type.DOUBLE=DOUBLE PRECISION
type.FLOAT=REAL
type.INTEGER=INTEGER
type.LONGNVARCHAR=TEXT
type.LONGVARCHAR=TEXT
type.NUMERIC=NUMERIC(10,0)
type.REAL=REAL
type.SMALLINT=SMALLINT
type.TIME=TIME
type.TIMESTAMP=TIMESTAMP
type.TINYINT=SMALLINT
type.VARBINARY=BYTEA
type.VARCHAR=VARCHAR(255)
#
# DDL / DML 关键字
auto-increment-keyword=GENERATED BY DEFAULT AS IDENTITY
alter-column-string=ALTER COLUMN
current-timestamp-sql=SELECT CURRENT_TIMESTAMP
#
# UPSERT
upsert-template=insert into {table} ({columns}) values ({values}) on conflict do update set {updateSet}
#
# 触发器查询模板（不支持时返回 null，使用 pg_trigger 默认 SQL）
# trigger-list-sql=
# trigger-sql=
#
# 存储过程查询模板
# procedure-list-sql=
# procedure-sql=
