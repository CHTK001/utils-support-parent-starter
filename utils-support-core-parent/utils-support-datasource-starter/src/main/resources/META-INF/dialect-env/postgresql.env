# ============================================
# PostgreSQL 14+ 方言配置（兼容 12/13）
# 对应类：PostgresqlDialect / Postgresql9Dialect / Postgresql10Dialect
# 文件：META-INF/dialect-env/postgresql.env
# ============================================

# --- 基础标识 ---
protocol=postgresql
driver=org.postgresql.Driver
url=

# --- 引用符 ---
quote-open="
quote-close="

# --- 自增 / 引擎 ---
auto-increment-keyword=GENERATED BY DEFAULT AS IDENTITY
alter-column-string=ALTER COLUMN
supports-upsert=true
upsert-template=insert into {table} ({columns}) values ({values}) on conflict do update set {updateSet}

# --- 注释 ---
table-comment=
column-comment=
supports-inline-comment=false
supports-partition=true

# --- 时间戳 ---
current-timestamp-sql=SELECT CURRENT_TIMESTAMP

# --- 向量 / JSON ---
supports-vector=true
supports-json=true

# --- JDBC 类型映射 ---
type.BIGINT=BIGINT
type.BINARY=BYTEA
type.BIT=BOOLEAN
type.BLOB=BYTEA
type.BOOLEAN=BOOLEAN
type.CHAR=CHAR(255)
type.CLOB=TEXT
type.DATE=DATE
type.DECIMAL=NUMERIC(10,0)
type.DOUBLE=DOUBLE PRECISION
type.FLOAT=REAL
type.INTEGER=INTEGER
type.LONGNVARCHAR=TEXT
type.LONGVARCHAR=TEXT
type.NUMERIC=NUMERIC(10,0)
type.REAL=REAL
type.SMALLINT=SMALLINT
type.TIME=TIME
type.TIMESTAMP=TIMESTAMP
type.TINYINT=SMALLINT
type.VARBINARY=BYTEA
type.VARCHAR=VARCHAR(255)

# --- 触发器查询 ---
trigger-list-sql=SELECT t.tgname AS TRIGGER_NAME, n.nspname AS TRIGGER_SCHEMA, c.relname AS TABLE_NAME, CASE WHEN t.tgtype::int & 2 <> 0 THEN 'BEFORE' WHEN t.tgtype::int & 64 <> 0 THEN 'INSTEAD OF' ELSE 'AFTER' END AS ACTION_TIMING, CASE WHEN t.tgtype::int & 4 <> 0 THEN 'INSERT' WHEN t.tgtype::int & 8 <> 0 THEN 'DELETE' WHEN t.tgtype::int & 16 <> 0 THEN 'UPDATE' WHEN t.tgtype::int & 32 <> 0 THEN 'TRUNCATE' END AS EVENT_MANIPULATION, pg_get_triggerdef(t.oid) AS ACTION_STATEMENT FROM pg_trigger t JOIN pg_class c ON c.oid = t.tgrelid JOIN pg_namespace n ON n.oid = c.relnamespace WHERE NOT t.tgisinternal
trigger-sql=SELECT * FROM ({list_sql}) T WHERE trigger_name = '{trigger_name}'

# --- 存储过程查询 ---
procedure-list-sql=SELECT n.nspname AS ROUTINE_SCHEMA, p.proname AS ROUTINE_NAME, CASE p.prokind WHEN 'p' THEN 'PROCEDURE' ELSE 'FUNCTION' END AS ROUTINE_TYPE, pg_get_function_result(p.oid) AS DATA_TYPE, pg_get_functiondef(p.oid) AS ROUTINE_DEFINITION FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace WHERE p.prokind IN ('p', 'f') AND n.nspname NOT IN ('pg_catalog', 'information_schema')
procedure-sql=SELECT * FROM ({list_sql}) T WHERE routine_name = '{procedure_name}'

# --- Schema 条件模板 ---
schema-condition-template= AND {column} = '{value}'
