# ============================================
# Apache Derby 10.15+ 方言配置
# 文件：META-INF/dialect-env/derby.env
# ============================================

protocol=derby
driver=org.apache.derby.jdbc.EmbeddedDriver
url=jdbc:derby:<DATABASE>;create=true
quote-open="
quote-close="

auto-increment-keyword=GENERATED BY DEFAULT AS IDENTITY
alter-column-string=ALTER COLUMN
supports-upsert=false
supports-inline-comment=false
supports-partition=false
supports-vector=false
supports-json=false

current-timestamp-sql=SELECT CURRENT_TIMESTAMP FROM SYSIBM.SYSDUMMY1

type.BIGINT=BIGINT
type.BINARY=BINARY
type.BIT=BOOLEAN
type.BLOB=BLOB
type.BOOLEAN=BOOLEAN
type.CHAR=CHAR(255)
type.CLOB=CLOB
type.DATE=DATE
type.DECIMAL=DECIMAL(10,0)
type.DOUBLE=DOUBLE
type.FLOAT=REAL
type.INTEGER=INTEGER
type.LONGNVARCHAR=LONG VARCHAR
type.LONGVARCHAR=LONG VARCHAR
type.NUMERIC=DECIMAL(10,0)
type.REAL=REAL
type.SMALLINT=SMALLINT
type.TIME=TIME
type.TIMESTAMP=TIMESTAMP
type.TINYINT=SMALLINT
type.VARBINARY=VARBINARY(255)
type.VARCHAR=VARCHAR(255)

# Derby 分页（OFFSET ... ROWS FETCH NEXT ... ROWS ONLY）
pagination-sql={sql} OFFSET {offset} ROWS FETCH NEXT {limit} ROWS ONLY

trigger-list-sql=SELECT TRIGGER_NAME, TRIGGER_SCHEMA, EVENT_OBJECT_TABLE AS TABLE_NAME, ACTION_TIMING, EVENT_MANIPULATION, ACTION_STATEMENT FROM INFORMATION_SCHEMA.TRIGGERS
trigger-sql=SELECT * FROM ({list_sql}) T WHERE TRIGGER_NAME = '{trigger_name}'
schema-condition-template= AND {column} = '{value}'
