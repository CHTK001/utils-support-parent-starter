# ============================================
# H2 2.x 方言配置
# 文件：META-INF/dialect-env/h2.env
# ============================================

protocol=h2
driver=org.h2.Driver
url=jdbc:h2:mem:test;DB_CLOSE_DELAY=-1

quote-open="
quote-close="

auto-increment-keyword=AUTO_INCREMENT
alter-column-string=ALTER COLUMN
supports-upsert=true
upsert-template=MERGE INTO {table} ({columns}) VALUES ({values})
supports-inline-comment=false
supports-partition=false

current-timestamp-sql=SELECT CURRENT_TIMESTAMP

type.BIGINT=BIGINT
type.BINARY=BINARY
type.BIT=BOOLEAN
type.BLOB=BLOB
type.BOOLEAN=BOOLEAN
type.CHAR=CHAR(255)
type.CLOB=CLOB
type.DATE=DATE
type.DECIMAL=DECIMAL(10,0)
type.DOUBLE=DOUBLE
type.FLOAT=FLOAT
type.INTEGER=INTEGER
type.LONGNVARCHAR=VARCHAR
type.LONGVARCHAR=VARCHAR
type.NUMERIC=NUMERIC(10,0)
type.REAL=REAL
type.SMALLINT=SMALLINT
type.TIME=TIME
type.TIMESTAMP=TIMESTAMP
type.TINYINT=TINYINT
type.VARBINARY=VARBINARY(255)
type.VARCHAR=VARCHAR(255)

trigger-list-sql=SELECT TRIGGER_NAME, TRIGGER_SCHEMA, EVENT_OBJECT_TABLE AS TABLE_NAME, ACTION_TIMING, EVENT_MANIPULATION, ACTION_STATEMENT, STATUS FROM INFORMATION_SCHEMA.TRIGGERS
trigger-sql=SELECT * FROM ({list_sql}) T WHERE TRIGGER_NAME = '{trigger_name}'

schema-condition-template= AND {column} = '{value}'
