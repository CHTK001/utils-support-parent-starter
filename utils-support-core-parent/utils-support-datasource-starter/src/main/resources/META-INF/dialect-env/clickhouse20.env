# ============================================
# ClickHouse 20.x 方言配置（旧版 yandex 驱动）
# 文件：META-INF/dialect-env/clickhouse20.env
# ============================================

protocol=clickhouse20
driver=ru.yandex.clickhouse.ClickHouseDriver
url=jdbc:clickhouse://<IP>:<PORT>/<DATABASE>

quote-open=`
quote-close=`

alter-column-string=MODIFY COLUMN
# ClickHouse 无真正 upsert，显式关闭
supports-upsert=false
supports-inline-comment=false
supports-partition=true

current-timestamp-sql=SELECT NOW()

type.BIGINT=Int64
type.BINARY=String
type.BIT=UInt8
type.BLOB=String
type.BOOLEAN=UInt8
type.CHAR=String
type.CLOB=String
type.DATE=Date
type.DECIMAL=Decimal({prec},{scl})
type.DOUBLE=Float64
type.FLOAT=Float32
type.INTEGER=Int32
type.LONGNVARCHAR=String
type.LONGVARCHAR=String
type.NUMERIC=Decimal({prec},{scl})
type.REAL=Float32
type.SMALLINT=Int16
type.TIME=DateTime
type.TIMESTAMP=DateTime
type.TINYINT=Int8
type.VARBINARY=String
type.VARCHAR=String

schema-condition-template= AND {column} = '{value}'
