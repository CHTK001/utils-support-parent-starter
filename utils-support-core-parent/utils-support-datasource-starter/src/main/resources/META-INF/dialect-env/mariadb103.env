# ============================================
# MariaDB 10.3 方言配置
# 文件：META-INF/dialect-env/mariadb103.env
# ============================================

protocol=mariadb103
driver=org.mariadb.jdbc.Driver
url=jdbc:mariadb://<IP>:<PORT>/<DATABASE>?useSSL=false&serverTimezone=Asia/Shanghai
quote-open=`
quote-close=`

auto-increment-keyword=AUTO_INCREMENT
alter-column-string=MODIFY COLUMN
supports-upsert=true
upsert-template=insert into {table} ({columns}) values ({values}) on duplicate key update {updateSet}
supports-inline-comment=true
supports-partition=true
engine-keyword=ENGINE
storage-engine=INNODB
table-type= ENGINE=InnoDB DEFAULT CHARSET=utf8
supports-vector=false
supports-json=true

current-timestamp-sql=SELECT NOW()

type.BIGINT=BIGINT
type.BINARY=BLOB
type.BIT=BIT
type.BLOB=BLOB
type.BOOLEAN=TINYINT(1)
type.CHAR=CHAR(255)
type.CLOB=LONGTEXT
type.DATE=DATE
type.DECIMAL=DECIMAL(10,0)
type.DOUBLE=DOUBLE
type.FLOAT=FLOAT
type.INTEGER=INT
type.LONGNVARCHAR=TEXT
type.LONGVARCHAR=TEXT
type.NUMERIC=DECIMAL(10,0)
type.REAL=REAL
type.SMALLINT=SMALLINT
type.TIME=TIME
type.TIMESTAMP=DATETIME
type.TINYINT=TINYINT
type.VARBINARY=VARBINARY(255)
type.VARCHAR=VARCHAR(255)

trigger-list-sql=SELECT TRIGGER_NAME, TRIGGER_SCHEMA, EVENT_OBJECT_TABLE AS TABLE_NAME, ACTION_TIMING, EVENT_MANIPULATION, ACTION_STATEMENT FROM INFORMATION_SCHEMA.TRIGGERS
trigger-sql=SELECT * FROM ({list_sql}) T WHERE TRIGGER_NAME = '{trigger_name}'
procedure-list-sql=SELECT ROUTINE_SCHEMA, ROUTINE_NAME, ROUTINE_TYPE, DATA_TYPE, ROUTINE_DEFINITION, ROUTINE_COMMENT, SECURITY_TYPE, ROUTINE_BODY FROM INFORMATION_SCHEMA.ROUTINES WHERE ROUTINE_TYPE IN ('PROCEDURE', 'FUNCTION')
procedure-sql=SELECT * FROM ({list_sql}) T WHERE ROUTINE_NAME = '{procedure_name}'
schema-condition-template= AND {column} = '{value}'
