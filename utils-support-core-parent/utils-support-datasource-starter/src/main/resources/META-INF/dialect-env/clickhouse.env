# ============================================
# ClickHouse 22.x+ 方言配置
# 文件：META-INF/dialect-env/clickhouse.env
# ============================================

protocol=clickhouse
driver=com.clickhouse.jdbc.ClickHouseDriver
url=jdbc:clickhouse://<IP>:<PORT>/<DATABASE>

quote-open=`
quote-close=`

alter-column-string=MODIFY COLUMN
supports-upsert=true
upsert-template=INSERT INTO {table} ({columns}) VALUES ({values})
supports-inline-comment=false
supports-partition=true

current-timestamp-sql=SELECT NOW()

type.BIGINT=Int64
type.BINARY=String
type.BIT=UInt8
type.BLOB=String
type.BOOLEAN=UInt8
type.CHAR=String
type.CLOB=String
type.DATE=Date
type.DECIMAL=Decimal({prec},{scl})
type.DOUBLE=Float64
type.FLOAT=Float32
type.INTEGER=Int32
type.LONGNVARCHAR=String
type.LONGVARCHAR=String
type.NUMERIC=Decimal({prec},{scl})
type.REAL=Float32
type.SMALLINT=Int16
type.TIME=DateTime
type.TIMESTAMP=DateTime
type.TINYINT=Int8
type.VARBINARY=String
type.VARCHAR=String

schema-condition-template= AND {column} = '{value}'
