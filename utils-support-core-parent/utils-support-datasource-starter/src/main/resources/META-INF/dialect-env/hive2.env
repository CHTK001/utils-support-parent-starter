# ============================================
# Hive 2.x 方言配置
# 文件：META-INF/dialect-env/hive2.env
# ============================================

protocol=hive2
driver=org.apache.hive.jdbc.HiveDriver
url=jdbc:hive2://<IP>:<PORT>/<DATABASE>
quote-open=`
quote-close=`

supports-upsert=false
supports-inline-comment=false
supports-partition=true
supports-vector=false
supports-json=false
alter-column-string=

current-timestamp-sql=SELECT CURRENT_TIMESTAMP

type.BIGINT=BIGINT
type.BINARY=BINARY
type.BIT=BOOLEAN
type.BLOB=BINARY
type.BOOLEAN=BOOLEAN
type.CHAR=STRING
type.CLOB=STRING
type.DATE=DATE
type.DECIMAL=DECIMAL({prec},{scl})
type.DOUBLE=DOUBLE
type.FLOAT=FLOAT
type.INTEGER=INT
type.LONGNVARCHAR=STRING
type.LONGVARCHAR=STRING
type.NUMERIC=DECIMAL({prec},{scl})
type.REAL=FLOAT
type.SMALLINT=SMALLINT
type.TIME=TIMESTAMP
type.TIMESTAMP=TIMESTAMP
type.TINYINT=TINYINT
type.VARBINARY=BINARY
type.VARCHAR=STRING
