<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>utils-support-core-parent</artifactId>
        <version>4.0.0.51</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>utils-support-maven-starter</artifactId>
    <name>Utils Support Maven Starter</name>
    <description>
        Utils Support Maven Starter - Maven 编译集成模块

        提供 Maven 项目的链式编译与构建支持。
        - 链式 Builder API 创建 MavenClient
        - 同步/异步 pom.xml 编译与构建
        - 编译过程实时进度回调
        - 自定义编译目标与 Profile
        - 基于 Maven Invoker 的独立进程编译
        - 支持 JDK 多版本切换
    </description>
    <properties>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.invoker.version>3.3.0</maven.invoker.version>
        <maven.shared.utils.version>4.0</maven.shared.utils.version>
        <!-- slf4j 版本统一由根 pom 的 ${slf4j.version} 管理，本模块不得覆盖：
             2.1.0-alpha2 在 alimaven / central / huaweicloud 等所有仓库均不存在，会导致依赖解析失败。 -->
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-git-starter</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.maven.shared</groupId>
            <artifactId>maven-invoker</artifactId>
            <version>${maven.invoker.version}</version>
        </dependency>

        <!-- SSH 部署支持（按需引入） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-ssh-starter</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

    </dependencies>
    <build>
        <plugins>
            
        </plugins>
    </build>
</project>