<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>utils-support-core-parent</artifactId>
        <version>4.0.0.42</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>utils-support-crawler-starter</artifactId>
    <name>Utils Support Crawler SPI Starter</name>
    <!--
      2026-09-26 起本模块只承担一件事：抓取/解析的可插拔 SPI 与数据模型
      （SpiderFetcher / SpiderParser / HttpFetcher / SpiderRequest / SpiderResponse 等）。

      原先内嵌的整套爬虫平台（/spider/definitions、/spider/executions、/spider/proxy-pools
      三个控制器共 16 个端点、3 个 Store、SpiderRunner 与 SpiderTimerService 定时调度器）
      已整体下线，能力由 spring-api-support-collect-starter（/v2/collect/**）承接，
      同时删除了 AutoConfiguration.imports，避免任何依赖本模块的应用被动注册重复端点。

      【不要因为名字里带 spider 就删掉本模块】它仍被两个模块真实依赖：
        · spring-api-support-collect-starter  —— CollectRequestExecutor 用 HttpFetcher 发起抓取
        · utils-support-playwright-starter   —— PlaywrightFetcher/PlaywrightParser 实现同一套 SPI
      抓取层不走 Spring 容器：HttpFetcher 由调用方直接 new，其它实现经 META-INF/services
      的 ServiceProvider SPI 装配，因此本模块没有也不需要任何自动配置。

      更名已完成（2026-09-26）：模块 utils-support-spider-starter 改为
      utils-support-crawler-starter，包 com.chua.spider.support 改为 com.chua.crawler.support。
      29 个类、两个消费者、native-image 元数据与 META-INF/extensions 的 SPI 注册文件
      （文件名本身即接口全限定名）已同步迁移。类名保持不变，故本段仍以 Spider* 描述 API。
    -->
    <description>抓取/解析 SPI 与数据模型（可插拔 Fetcher / Parser）。爬虫平台已下线，能力由 spring-api-support-collect-starter 承接；本模块仍被 collect 与 playwright-starter 依赖，不可删除。</description>

    <!--
      2026-09-28 解除 Boot 3 降级：本模块原先局部定义 spring.boot.version=3.2.0、
      spring.version=6.1.14，并把字节码从 25 降到 21，理由是「Spring 6.1 的 ASM
      不识别 JDK 25 产出的 class 文件版本 69」。该约束随 Spring 7 / Boot 4 已失效：
      Spring 7.0.8 的 ASM 支持 class 69，故此处不再需要任何覆盖，
      全部交由 utils-support-parent-starter 统一提供（Boot 4.1.0 / Spring 7.0.8 / 字节码 25）。
      保留本段仅为固化 properties 区的可读结构。
    -->
    <properties>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- 核心依赖 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- HTML 解析与链接提取（运行时调用 Jsoup.parse） -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
            <scope>compile</scope>
        </dependency>

        <!-- HTTP 抓取备选（核心实现使用 JDK HttpClient），未在代码中直接 import -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>${okhttp.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- JSON 序列化（运行时 new ObjectMapper） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- Spring Boot 自动配置（运行时反射 @AutoConfiguration/@ConditionalOnClass） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- Spring Web 注解（运行时 MVC 反射 @RestController） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- Spring Context（运行时反射 @Configuration/@Bean） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- 完整 Spring Boot starter（保证 spring-core 版本一致） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- Jakarta 注解（@PostConstruct / @PreDestroy 运行时反射） -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>compile</scope>
        </dependency>
    </dependencies>
</project>
