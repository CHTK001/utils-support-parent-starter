<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>utils-support-core-parent</artifactId>
        <version>4.0.0.42</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>utils-support-flyway-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>
    <name>Utils Support Flyway Maven Plugin</name>
    <description>Flyway 辅助 Maven 插件：递归扫描项目目录下的初始化脚本，合并生成单一 init SQL（mode=single）或运行期可直接执行的 init/initdata 两份脚本（mode=initdata）</description>

    <properties>
        <maven.api.version>3.9.16</maven.api.version>
        <maven.plugin.annotations.version>3.16.0</maven.plugin.annotations.version>
        <maven.plugin.plugin.version>3.16.0</maven.plugin.plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${maven.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${maven.plugin.annotations.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- 源码引用 com.chua.common.support.collection.wrap.Wraps（集合包装工具），必须进插件运行期
             classpath，故用默认 compile scope（会随 plugin.xml 声明为插件依赖）；版本由 root 依赖管理托管 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Maven 插件是构建工具，无需 Java 25 字节码；降到 17 以兼容描述符生成器的 ASM -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>
            <!-- 2026-10-06 升级 3.9.0 → 3.16.0：支持 Java 25 环境，与 maven-plugin-annotations 3.16.0 配套；
                 3.16.0 已确认存在于本地仓库 D:\maven-repo，离线构建可用 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>${maven.plugin.plugin.version}</version>
                <configuration>
                    <goalPrefix>flyway</goalPrefix>
                </configuration>
                <executions>
                    <execution>
                        <id>default-descriptor</id>
                        <phase>process-classes</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
