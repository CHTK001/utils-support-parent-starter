<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>utils-support-extra-parent</artifactId>
        <version>4.0.0.42</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>utils-support-video-processor-starter</artifactId>
    <name>Utils Support Video Processor Starter</name>
    <description>视频转 HLS 处理器（Rust JNI）</description>
    <properties>
        <rust.skip>true</rust.skip>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Rust JNI 桥（运行时必须，JNI 在类加载阶段绑定 native 方法） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-native-video-processor</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- FFmpeg Rust 备用（代码未直接 import，可选） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-ffmpeg-rust-starter</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>build-native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>build-rust-native</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${rust.skip}</skip>
                                    <executable>cmd</executable>
                                    <arguments>
                                        <argument>/c</argument>
                                        <argument>build.bat</argument>
                                        <argument>release</argument>
                                    </arguments>
                                    <workingDirectory>${project.basedir}/src/main/rust</workingDirectory>
                                    <environmentVariables>
                                        <CARGO_HTTP_CHECK_REVOKE>false</CARGO_HTTP_CHECK_REVOKE>
                                    </environmentVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>build-native-linux</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>build-rust-native</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${rust.skip}</skip>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>build.sh</argument>
                                        <argument>release</argument>
                                    </arguments>
                                    <workingDirectory>${project.basedir}/src/main/rust</workingDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>build-native-macos</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>build-rust-native</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${rust.skip}</skip>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>build.sh</argument>
                                        <argument>release</argument>
                                    </arguments>
                                    <workingDirectory>${project.basedir}/src/main/rust</workingDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
