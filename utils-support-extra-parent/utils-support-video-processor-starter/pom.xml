<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>utils-support-extra-parent</artifactId>
        <version>4.0.0.42</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>utils-support-video-processor-starter</artifactId>
    <name>Utils Support Video Processor Starter</name>
    <description>视频转 HLS 处理器（Rust JNI）</description>
    <dependencies>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Rust JNI 桥与 Rust 源码均已迁入 native 模块：绑定类 VideoProcessorBridge
             位于 utils-support-native-video-processor，并且是该模块的源文件，故必须是
             compile scope，否则编译期看不到 com.chua.video.processor.support.bridge 包。
             原生库构建（src/main/rust/build.sh）同样由 native 模块负责。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-native-video-processor</artifactId>
            <version>${project.version}</version>
            <scope>compile</scope>
        </dependency>
        <!-- FFmpeg Rust 备用（代码未直接 import，可选） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-ffmpeg-rust-starter</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

    </dependencies>
</project>
