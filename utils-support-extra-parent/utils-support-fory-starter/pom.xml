<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>utils-support-extra-parent</artifactId>
        <version>4.0.0.42</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>utils-support-fory-starter</artifactId>
    <name>Utils Support Fory Starter</name>
    <description>Apache Fory 高性能多语言序列化模块：零反射、引用跟踪、跨语言互操作</description>
    <properties>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.fury</groupId>
            <artifactId>fury-core</artifactId>
        </dependency>

        <!-- fory-json：Fory 官方 JSON 序列化模块，用于实现 JsonProvider（ForyJsonProvider） -->
        <dependency>
            <groupId>org.apache.fory</groupId>
            <artifactId>fory-json</artifactId>
        </dependency>

        <!-- 仅编译期使用：@AutoSpi 注解 + AutoSpiAstProcessor 自动生成 META-INF/extensions SPI 索引 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-ast-starter</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- 父级 pluginManagement 只声明 lombok，会禁用 classpath 处理器发现；
                         这里显式叠加 AutoSpiAstProcessor 以启用 @AutoSpi 编译期 SPI 索引生成 -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>com.chua</groupId>
                            <artifactId>utils-support-ast-starter</artifactId>
                            <version>${project.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
