//! Rust Network Scanner (Nmap-like functionality)
//!
//! High-performance network scanning library with JNI bindings for Java.
//! Supports:
//! - TCP SYN scan
//! - TCP Connect scan  
//! - UDP scan
//! - Host discovery (ping sweep)
//! - Service detection
//! - OS fingerprinting (basic)

use jni::objects::{JClass, JString};
use jni::sys::{jboolean, jint, jlong, jstring, JNI_TRUE};
use jni::JNIEnv;
use serde::{Deserialize, Serialize};
use std::collections::HashMap;
use std::net::{IpAddr, SocketAddr, TcpStream};
use std::sync::atomic::{AtomicBool, Ordering};
use std::sync::Arc;
use std::time::Duration;
use tokio::net::TcpStream as TokioTcpStream;
use tokio::runtime::Runtime;
use tokio::sync::Semaphore;
use tokio::time::timeout;

static INITIALIZED: AtomicBool = AtomicBool::new(false);
static mut RUNTIME: Option<Runtime> = None;

/// Scan result for a single port
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct PortResult {
    pub port: u16,
    pub state: String, // "open", "closed", "filtered"
    pub service: Option<String>,
    pub version: Option<String>,
}

/// Scan result for a host
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct HostResult {
    pub ip: String,
    pub hostname: Option<String>,
    pub is_up: bool,
    pub ports: Vec<PortResult>,
    pub os_guess: Option<String>,
    pub scan_time_ms: u64,
}

/// JNI: Initialize the scanner
#[no_mangle]
pub extern "system" fn Java_com_chua_nmap_support_bridge_RustNmapBridge_nativeInit(
    _env: JNIEnv,
    _class: JClass,
) -> jboolean {
    if INITIALIZED.load(Ordering::SeqCst) {
        return JNI_TRUE;
    }

    // Initialize logger
    let _ = env_logger::try_init();

    // Create Tokio runtime
    match Runtime::new() {
        Ok(rt) => {
            unsafe {
                RUNTIME = Some(rt);
            }
            INITIALIZED.store(true, Ordering::SeqCst);
            log::info!("Rust Nmap scanner initialized");
            JNI_TRUE
        }
        Err(e) => {
            log::error!("Failed to create Tokio runtime: {}", e);
            0
        }
    }
}

/// JNI: Scan a single host
#[no_mangle]
pub extern "system" fn Java_com_chua_nmap_support_bridge_RustNmapBridge_nativeScanHost<'local>(
    mut env: JNIEnv<'local>,
    _class: JClass<'local>,
    host: JString<'local>,
    port_spec: JString<'local>,
    timeout_ms: jint,
    max_parallel: jint,
) -> jstring {
    let host: String = match env.get_string(&host) {
        Ok(s) => s.into(),
        Err(_) => return std::ptr::null_mut(),
    };

    let port_spec: String = match env.get_string(&port_spec) {
        Ok(s) => s.into(),
        Err(_) => return std::ptr::null_mut(),
    };

    let timeout_ms = timeout_ms as u64;
    let max_parallel = max_parallel as usize;

    let result = scan_host_internal(&host, &port_spec, timeout_ms, max_parallel);

    match serde_json::to_string(&result) {
        Ok(json) => env.new_string(&json).map(|s| s.into_raw()).unwrap_or(std::ptr::null_mut()),
        Err(_) => std::ptr::null_mut(),
    }
}

/// JNI: Scan multiple hosts
#[no_mangle]
pub extern "system" fn Java_com_chua_nmap_support_bridge_RustNmapBridge_nativeScanRange<'local>(
    mut env: JNIEnv<'local>,
    _class: JClass<'local>,
    cidr: JString<'local>,
    port_spec: JString<'local>,
    timeout_ms: jint,
    max_parallel: jint,
) -> jstring {
    let cidr: String = match env.get_string(&cidr) {
        Ok(s) => s.into(),
        Err(_) => return std::ptr::null_mut(),
    };

    let port_spec: String = match env.get_string(&port_spec) {
        Ok(s) => s.into(),
        Err(_) => return std::ptr::null_mut(),
    };

    let timeout_ms = timeout_ms as u64;
    let max_parallel = max_parallel as usize;

    let results = scan_range_internal(&cidr, &port_spec, timeout_ms, max_parallel);

    match serde_json::to_string(&results) {
        Ok(json) => env.new_string(&json).map(|s| s.into_raw()).unwrap_or(std::ptr::null_mut()),
        Err(_) => std::ptr::null_mut(),
    }
}

/// JNI: Check if host is up (ping)
#[no_mangle]
pub extern "system" fn Java_com_chua_nmap_support_bridge_RustNmapBridge_nativePing<'local>(
    mut env: JNIEnv<'local>,
    _class: JClass<'local>,
    host: JString<'local>,
    timeout_ms: jint,
) -> jboolean {
    let host: String = match env.get_string(&host) {
        Ok(s) => s.into(),
        Err(_) => return 0,
    };

    if is_host_up(&host, timeout_ms as u64) {
        JNI_TRUE
    } else {
        0
    }
}

/// JNI: TCP connect scan single port
#[no_mangle]
pub extern "system" fn Java_com_chua_nmap_support_bridge_RustNmapBridge_nativeTcpConnect<'local>(
    mut env: JNIEnv<'local>,
    _class: JClass<'local>,
    host: JString<'local>,
    port: jint,
    timeout_ms: jint,
) -> jboolean {
    let host: String = match env.get_string(&host) {
        Ok(s) => s.into(),
        Err(_) => return 0,
    };

    if tcp_connect(&host, port as u16, timeout_ms as u64) {
        JNI_TRUE
    } else {
        0
    }
}

/// JNI: Get service banner
#[no_mangle]
pub extern "system" fn Java_com_chua_nmap_support_bridge_RustNmapBridge_nativeGrabBanner<'local>(
    mut env: JNIEnv<'local>,
    _class: JClass<'local>,
    host: JString<'local>,
    port: jint,
    timeout_ms: jint,
) -> jstring {
    let host: String = match env.get_string(&host) {
        Ok(s) => s.into(),
        Err(_) => return std::ptr::null_mut(),
    };

    match grab_banner(&host, port as u16, timeout_ms as u64) {
        Some(banner) => env.new_string(&banner).map(|s| s.into_raw()).unwrap_or(std::ptr::null_mut()),
        None => std::ptr::null_mut(),
    }
}

// ==================== Internal Functions ====================

fn get_runtime() -> Option<&'static Runtime> {
    unsafe { RUNTIME.as_ref() }
}

fn scan_host_internal(host: &str, port_spec: &str, timeout_ms: u64, max_parallel: usize) -> HostResult {
    let start = std::time::Instant::now();
    let ports = parse_port_spec(port_spec);
    
    let is_up = is_host_up(host, timeout_ms);
    let hostname = resolve_hostname(host);
    
    let mut port_results = Vec::new();
    
    if is_up {
        if let Some(rt) = get_runtime() {
            port_results = rt.block_on(async {
                scan_ports_async(host, &ports, timeout_ms, max_parallel).await
            });
        }
    }

    HostResult {
        ip: host.to_string(),
        hostname,
        is_up,
        ports: port_results,
        os_guess: None,
        scan_time_ms: start.elapsed().as_millis() as u64,
    }
}

fn scan_range_internal(cidr: &str, port_spec: &str, timeout_ms: u64, max_parallel: usize) -> Vec<HostResult> {
    let hosts = expand_cidr(cidr);
    let ports = parse_port_spec(port_spec);
    
    let mut results = Vec::new();
    
    if let Some(rt) = get_runtime() {
        results = rt.block_on(async {
            let semaphore = Arc::new(Semaphore::new(max_parallel));
            let mut handles = Vec::new();
            
            for host in hosts {
                let sem = semaphore.clone();
                let ports = ports.clone();
                let timeout_ms = timeout_ms;
                
                let handle = tokio::spawn(async move {
                    let _permit = sem.acquire().await;
                    let start = std::time::Instant::now();
                    let is_up = is_host_up_async(&host, timeout_ms).await;
                    
                    let mut port_results = Vec::new();
                    if is_up {
                        port_results = scan_ports_async(&host, &ports, timeout_ms, 10).await;
                    }
                    
                    HostResult {
                        ip: host.clone(),
                        hostname: resolve_hostname(&host),
                        is_up,
                        ports: port_results,
                        os_guess: None,
                        scan_time_ms: start.elapsed().as_millis() as u64,
                    }
                });
                handles.push(handle);
            }
            
            let mut results = Vec::new();
            for handle in handles {
                if let Ok(result) = handle.await {
                    results.push(result);
                }
            }
            results
        });
    }
    
    results
}

async fn scan_ports_async(host: &str, ports: &[u16], timeout_ms: u64, max_parallel: usize) -> Vec<PortResult> {
    let semaphore = Arc::new(Semaphore::new(max_parallel));
    let mut handles = Vec::new();
    
    for &port in ports {
        let host = host.to_string();
        let sem = semaphore.clone();
        
        let handle = tokio::spawn(async move {
            let _permit = sem.acquire().await;
            let addr = format!("{}:{}", host, port);
            
            let state = match timeout(
                Duration::from_millis(timeout_ms),
                TokioTcpStream::connect(&addr),
            ).await {
                Ok(Ok(_)) => "open",
                Ok(Err(_)) => "closed",
                Err(_) => "filtered",
            };
            
            PortResult {
                port,
                state: state.to_string(),
                service: get_common_service(port),
                version: None,
            }
        });
        handles.push(handle);
    }
    
    let mut results = Vec::new();
    for handle in handles {
        if let Ok(result) = handle.await {
            if result.state == "open" {
                results.push(result);
            }
        }
    }
    
    results.sort_by_key(|r| r.port);
    results
}

async fn is_host_up_async(host: &str, timeout_ms: u64) -> bool {
    // Try common ports to check if host is up
    let common_ports = [80, 443, 22, 21, 25, 445, 3389];
    
    for port in common_ports {
        let addr = format!("{}:{}", host, port);
        if timeout(
            Duration::from_millis(timeout_ms / 2),
            TokioTcpStream::connect(&addr),
        ).await.is_ok() {
            return true;
        }
    }
    
    false
}

fn is_host_up(host: &str, timeout_ms: u64) -> bool {
    // Simple TCP connect check to common ports
    let common_ports = [80, 443, 22, 21, 25, 445, 3389];
    let timeout = Duration::from_millis(timeout_ms / common_ports.len() as u64);
    
    for port in common_ports {
        let addr = format!("{}:{}", host, port);
        if TcpStream::connect_timeout(
            &addr.parse().unwrap_or_else(|_| SocketAddr::from(([127, 0, 0, 1], port))),
            timeout,
        ).is_ok() {
            return true;
        }
    }
    
    false
}

fn tcp_connect(host: &str, port: u16, timeout_ms: u64) -> bool {
    let addr = format!("{}:{}", host, port);
    TcpStream::connect_timeout(
        &addr.parse().unwrap_or_else(|_| SocketAddr::from(([127, 0, 0, 1], port))),
        Duration::from_millis(timeout_ms),
    ).is_ok()
}

fn grab_banner(host: &str, port: u16, timeout_ms: u64) -> Option<String> {
    use std::io::{Read, Write};
    
    let addr = format!("{}:{}", host, port);
    let mut stream = TcpStream::connect_timeout(
        &addr.parse().ok()?,
        Duration::from_millis(timeout_ms),
    ).ok()?;
    
    stream.set_read_timeout(Some(Duration::from_millis(timeout_ms))).ok()?;
    
    // Send a simple probe
    let probe = match port {
        80 | 8080 => b"GET / HTTP/1.0\r\n\r\n".to_vec(),
        21 => vec![],  // FTP sends banner immediately
        22 => vec![],  // SSH sends banner immediately
        25 => vec![],  // SMTP sends banner immediately
        _ => vec![],
    };
    
    if !probe.is_empty() {
        stream.write_all(&probe).ok()?;
    }
    
    let mut buf = [0u8; 1024];
    let n = stream.read(&mut buf).ok()?;
    
    if n > 0 {
        Some(String::from_utf8_lossy(&buf[..n]).to_string())
    } else {
        None
    }
}

fn resolve_hostname(ip: &str) -> Option<String> {
    use dns_lookup::lookup_addr;
    
    if let Ok(addr) = ip.parse::<IpAddr>() {
        lookup_addr(&addr).ok()
    } else {
        None
    }
}

fn parse_port_spec(spec: &str) -> Vec<u16> {
    let mut ports = Vec::new();
    
    for part in spec.split(',') {
        let part = part.trim();
        if part.contains('-') {
            let range: Vec<&str> = part.split('-').collect();
            if range.len() == 2 {
                if let (Ok(start), Ok(end)) = (range[0].parse::<u16>(), range[1].parse::<u16>()) {
                    for port in start..=end {
                        ports.push(port);
                    }
                }
            }
        } else if let Ok(port) = part.parse::<u16>() {
            ports.push(port);
        }
    }
    
    if ports.is_empty() {
        // Default: common ports
        ports = vec![21, 22, 23, 25, 53, 80, 110, 143, 443, 445, 993, 995, 1433, 3306, 3389, 5432, 6379, 8080, 8443];
    }
    
    ports
}

fn expand_cidr(cidr: &str) -> Vec<String> {
    let mut hosts = Vec::new();
    
    if cidr.contains('/') {
        let parts: Vec<&str> = cidr.split('/').collect();
        if parts.len() == 2 {
            if let (Some(base_ip), Ok(prefix)) = (parse_ip(parts[0]), parts[1].parse::<u8>()) {
                let mask = !0u32 >> prefix;
                let base = ip_to_u32(&base_ip);
                let count = (1u32 << (32 - prefix)).min(65536); // Limit to 65536 hosts
                
                for i in 1..count.saturating_sub(1) {
                    let ip = u32_to_ip(base + i);
                    hosts.push(ip);
                }
            }
        }
    } else if cidr.contains('-') {
        // Range like 192.168.1.1-10
        let parts: Vec<&str> = cidr.rsplitn(2, '.').collect();
        if parts.len() == 2 {
            let range_part = parts[0];
            let base = parts[1];
            
            if range_part.contains('-') {
                let range: Vec<&str> = range_part.split('-').collect();
                if range.len() == 2 {
                    if let (Ok(start), Ok(end)) = (range[0].parse::<u8>(), range[1].parse::<u8>()) {
                        for i in start..=end {
                            hosts.push(format!("{}.{}", base, i));
                        }
                    }
                }
            }
        }
    } else {
        hosts.push(cidr.to_string());
    }
    
    hosts
}

fn parse_ip(s: &str) -> Option<[u8; 4]> {
    let parts: Vec<&str> = s.split('.').collect();
    if parts.len() != 4 {
        return None;
    }
    
    let mut ip = [0u8; 4];
    for (i, part) in parts.iter().enumerate() {
        ip[i] = part.parse().ok()?;
    }
    Some(ip)
}

fn ip_to_u32(ip: &[u8; 4]) -> u32 {
    ((ip[0] as u32) << 24) | ((ip[1] as u32) << 16) | ((ip[2] as u32) << 8) | (ip[3] as u32)
}

fn u32_to_ip(n: u32) -> String {
    format!("{}.{}.{}.{}", (n >> 24) & 0xFF, (n >> 16) & 0xFF, (n >> 8) & 0xFF, n & 0xFF)
}

fn get_common_service(port: u16) -> Option<String> {
    let services: HashMap<u16, &str> = [
        (21, "ftp"), (22, "ssh"), (23, "telnet"), (25, "smtp"),
        (53, "dns"), (80, "http"), (110, "pop3"), (143, "imap"),
        (443, "https"), (445, "smb"), (993, "imaps"), (995, "pop3s"),
        (1433, "mssql"), (3306, "mysql"), (3389, "rdp"), (5432, "postgresql"),
        (6379, "redis"), (8080, "http-proxy"), (8443, "https-alt"),
        (27017, "mongodb"), (5672, "amqp"), (9092, "kafka"),
    ].iter().cloned().collect();
    
    services.get(&port).map(|s| s.to_string())
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_parse_port_spec() {
        assert_eq!(parse_port_spec("80"), vec![80]);
        assert_eq!(parse_port_spec("80,443"), vec![80, 443]);
        assert_eq!(parse_port_spec("80-82"), vec![80, 81, 82]);
        assert_eq!(parse_port_spec("80,443,8080-8082"), vec![80, 443, 8080, 8081, 8082]);
    }

    #[test]
    fn test_expand_cidr() {
        let hosts = expand_cidr("192.168.1.1");
        assert_eq!(hosts, vec!["192.168.1.1"]);
    }
}
